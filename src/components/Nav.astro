---
import { t, getLocalePath, type Locale } from '../i18n/translations';
import type { AlternatePaths } from '../lib/seo';

interface Props {
  locale: Locale;
  currentPath?: string;
  alternatePaths?: AlternatePaths;
}

const { locale, currentPath = '', alternatePaths } = Astro.props;
const strings = t(locale);
const otherLocale = locale === 'pl' ? 'en' : 'pl';
const languageSwitchHref = alternatePaths?.[otherLocale] ?? getLocalePath(otherLocale, '/');

const isHome = currentPath === '/' || currentPath === '';
const isBlog = currentPath.startsWith('/blog');
const isAbout = currentPath.includes('o-projekcie') || currentPath.includes('about');
---

<nav class="site-nav" aria-label="Primary">
  <div class="nav-inner">
    <a href={getLocalePath(locale, '/')} class="logo" aria-label="quality blog — home">
      <span class="mark" aria-hidden="true">q</span>
      <span class="logotype">
        <span class="logo-main">quality</span><span class="logo-sub">blog</span>
      </span>
    </a>

    <div class="nav-links">
      <a href={getLocalePath(locale, '/')} class:list={[{ active: isHome }]}>
        <span>{strings.nav.home}</span>
      </a>
      <a href={getLocalePath(locale, '/blog/')} class:list={[{ active: isBlog }]}>
        <span>{strings.nav.blog}</span>
      </a>
      <a href={getLocalePath(locale, locale === 'pl' ? '/o-projekcie/' : '/about/')} class:list={[{ active: isAbout }]}>
        <span>{strings.nav.about}</span>
      </a>

      <div class="nav-divider" aria-hidden="true"></div>

      <button
        type="button"
        class="icon-btn"
        data-theme-toggle
        aria-label={locale === 'pl' ? 'Przełącz motyw' : 'Toggle theme'}
        title={locale === 'pl' ? 'Przełącz motyw' : 'Toggle theme'}
      >
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="icon-sun">
          <circle cx="12" cy="12" r="4"/>
          <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
        </svg>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round" class="icon-moon">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>

      <a href={languageSwitchHref} class="lang-switch">
        {locale === 'pl' ? 'EN' : 'PL'}
      </a>
    </div>
  </div>
</nav>

<style>
  .site-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    background: color-mix(in oklab, var(--bg) 88%, transparent);
    border-bottom: 1px solid var(--border);
  }
  .nav-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px clamp(20px, 4vw, 40px);
    max-width: var(--max-width);
    margin-inline: auto;
    height: 56px;
  }
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 9px;
  }
  .mark {
    width: 22px;
    height: 22px;
    border-radius: 5px;
    background: var(--fg);
    color: var(--bg);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    flex-shrink: 0;
  }
  .logotype {
    font-family: var(--font-body);
    font-weight: 600;
    font-size: 15.5px;
    letter-spacing: -0.015em;
    line-height: 1;
    color: var(--fg);
  }
  .logo-sub {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    color: var(--fg-muted);
    margin-left: 1px;
  }
  .nav-links {
    display: flex;
    gap: 2px;
    align-items: center;
  }
  .nav-links a {
    position: relative;
    color: var(--fg-muted);
    padding: 6px 10px;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: -0.005em;
    border-radius: 6px;
    transition: color 180ms ease, background 180ms ease;
  }
  .nav-links a:hover {
    color: var(--fg);
  }
  .nav-links a.active {
    color: var(--fg);
  }
  .nav-divider {
    width: 1px;
    height: 16px;
    background: var(--border);
    margin: 0 6px;
  }
  .icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 6px;
    color: var(--fg-muted);
    position: relative;
    border: 1px solid transparent;
    transition: color 180ms ease, background 180ms ease, border-color 180ms ease;
  }
  .icon-btn:hover {
    color: var(--fg);
    background: var(--bg-elev);
    border-color: var(--border);
  }
  .icon-btn:active { transform: scale(0.96); }
  .icon-btn .icon-sun,
  .icon-btn .icon-moon {
    position: absolute;
    transition: opacity 220ms ease, transform 220ms ease;
  }
  :global([data-theme='dark']) .icon-sun { opacity: 1; transform: scale(1) rotate(0); }
  :global([data-theme='dark']) .icon-moon { opacity: 0; transform: scale(0.6) rotate(-90deg); }
  :global([data-theme='light']) .icon-sun { opacity: 0; transform: scale(0.6) rotate(90deg); }
  :global([data-theme='light']) .icon-moon { opacity: 1; transform: scale(1) rotate(0); }

  .lang-switch {
    font-family: var(--font-mono) !important;
    font-size: 10.5px !important;
    font-weight: 500 !important;
    letter-spacing: 0.05em;
    color: var(--fg-muted) !important;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    padding: 4px 8px !important;
    border-radius: 4px !important;
    text-transform: uppercase;
    line-height: 1.4;
  }
  .lang-switch:hover {
    color: var(--fg) !important;
    background: var(--bg-elev) !important;
    border-color: var(--fg-subtle);
  }
  .lang-switch.active::after { display: none; }

  @media (max-width: 640px) {
    .nav-inner { padding: 10px 16px; }
    .nav-links { gap: 0; }
    .nav-links a { padding: 5px 8px; font-size: 13px; }
    .nav-divider { margin: 0 2px; }
    .logo-main { display: none; }
    .logo-sub { font-size: 17px; }
  }
</style>
