---
import Tag from './Tag.astro';
import type { Locale } from '../i18n/translations';
import { t } from '../i18n/translations';
import { postAuthorNamesLabel, type AuthorInput } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  date: Date;
  author: AuthorInput;
  readingTime: number;
  tags: string[];
  slug: string;
  locale: Locale;
  index?: number;
}

const { title, description, date, author, readingTime, tags, slug, locale, index } = Astro.props;
const strings = t(locale);
const authorName = postAuthorNamesLabel(author, locale);

const formattedDate = date.toLocaleDateString(locale === 'pl' ? 'pl-PL' : 'en-US', {
  day: 'numeric',
  month: 'short',
  year: 'numeric',
});

// Primary category drives the accent
const primary = (tags[0] ?? 'default')
  .toLowerCase()
  .replace(/\//g, '-')
  .replace(/[^a-z0-9-]+/g, '-')
  .replace(/^-+|-+$/g, '');
---

<a href={`/${locale}/blog/${slug}/`} class="post-card" data-cat={primary}>
  <div class="post-card__meta">
    {typeof index === 'number' && (
      <span class="idx">{String(index).padStart(2, '0')}</span>
    )}
    <span class="date">{formattedDate}</span>
    <span class="dot-sep" aria-hidden="true">·</span>
    <span class="rt">{readingTime} {strings.posts.readingTime}</span>
  </div>

  <h3 class="post-card__title">{title}</h3>
  <p class="post-card__desc">{description}</p>

  <div class="post-card__footer">
    <div class="post-card__tags">
      {tags.slice(0, 2).map((tag) => <Tag label={tag} variant="ghost" />)}
    </div>
    <span class="author">{authorName}</span>
  </div>
</a>

<style>
  .post-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    transition: transform 240ms cubic-bezier(0.16, 1, 0.3, 1), box-shadow 240ms ease, border-color 240ms ease;
  }
  .post-card:hover {
    transform: translateY(-1px);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
    border-color: var(--fg-subtle);
  }

  .post-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--fg-subtle);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .idx {
    color: var(--cat, var(--fg));
    font-weight: 600;
    margin-right: 2px;
  }
  .dot-sep { opacity: 0.6; }

  .post-card__title {
    font-family: var(--font-body);
    font-size: clamp(17px, 1.1vw + 12px, 20px);
    font-weight: 600;
    color: var(--fg);
    line-height: 1.25;
    letter-spacing: -0.018em;
    margin-top: 4px;
  }

  .post-card__desc {
    font-size: 14px;
    color: var(--fg-muted);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-card__footer {
    margin-top: auto;
    padding-top: 14px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    border-top: 1px solid var(--border-soft);
  }
  .post-card__tags {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
    min-width: 0;
  }
  .author {
    font-family: var(--font-mono);
    font-size: 10.5px;
    color: var(--fg-subtle);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    flex-shrink: 0;
  }
</style>
