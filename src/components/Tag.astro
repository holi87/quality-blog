---
interface Props {
  label: string;
  href?: string;
  variant?: 'solid' | 'outline' | 'ghost' | 'accent';
  size?: 'sm' | 'md';
  /** slug-ish key to color-code categories via [data-cat] */
  category?: string;
}

const { label, href, variant = 'ghost', size = 'sm', category } = Astro.props;

const cat = (category ?? label)
  .toLowerCase()
  .replace(/\//g, '-')
  .replace(/[^a-z0-9-]+/g, '-')
  .replace(/^-+|-+$/g, '');

const Element = (href ? 'a' : 'span') as any;
---

<Element
  class:list={['tag', `tag--${variant}`, `tag--${size}`, href && 'is-link']}
  href={href}
  data-cat={cat}
>
  <span class="dot" aria-hidden="true"></span>
  <span class="label">{label}</span>
</Element>

<style>
  .tag {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-weight: 500;
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    line-height: 1;
    border-radius: 999px;
    padding: 4px 10px;
    color: var(--cat-fg, var(--fg-muted));
    background: var(--cat-bg, var(--bg-elev));
    border: 1px solid transparent;
    transition: opacity 160ms, transform 160ms;
    white-space: nowrap;
  }
  .tag--md { font-size: 11.5px; padding: 5px 12px; }
  .tag .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.85;
  }

  .tag--ghost {
    background: transparent;
    border-color: var(--border);
    color: var(--fg-muted);
  }
  .tag--ghost .dot { background: var(--cat, var(--fg-muted)); opacity: 1; }
  .tag--outline {
    background: transparent;
    border-color: var(--border);
    color: var(--fg);
  }
  .tag--outline .dot { background: var(--cat, var(--fg-muted)); opacity: 1; }
  .tag--solid {
    background: var(--cat-bg, var(--bg-elev));
    color: var(--cat-fg, var(--fg));
  }
  .tag--accent {
    background: var(--cat-bg, var(--bg-elev));
    color: var(--cat-fg, var(--fg));
  }

  .is-link { cursor: pointer; }
  .is-link:hover { transform: translateY(-1px); }
</style>
