---
import { t, type Locale, getLocalePath } from '../i18n/translations';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const strings = t(locale);

const rssLabel = locale === 'pl' ? 'RSS' : 'RSS';
const blogLabel = locale === 'pl' ? 'Blog' : 'Blog';
const aboutLabel = locale === 'pl' ? 'O projekcie' : 'About';
const exploreLabel = locale === 'pl' ? 'Odkryj' : 'Explore';
const findUsLabel = locale === 'pl' ? 'Znajdź nas' : 'Find us';
---

<footer class="site-footer">
  <div class="footer-top container">
    <div class="brand">
      <div class="logo-row">
        <span class="mark" aria-hidden="true">q</span>
        <span class="brand-name">quality<em>blog</em></span>
      </div>
      <p class="tagline">
        {locale === 'pl'
          ? 'Praktyczna wiedza o AI, smart home i QA — bez marketingowego szumu.'
          : 'Practical knowledge about AI, smart home and QA — no marketing fluff.'}
      </p>
    </div>

    <div class="col">
      <p class="col-title eyebrow">{exploreLabel}</p>
      <ul>
        <li><a href={getLocalePath(locale, '/')}>{strings.nav.home}</a></li>
        <li><a href={getLocalePath(locale, '/blog/')}>{blogLabel}</a></li>
        <li><a href={getLocalePath(locale, locale === 'pl' ? '/o-projekcie/' : '/about/')}>{aboutLabel}</a></li>
      </ul>
    </div>

    <div class="col">
      <p class="col-title eyebrow">{findUsLabel}</p>
      <ul>
        <li><a href={getLocalePath(locale, '/rss.xml')}>{rssLabel}</a></li>
        <li><a href="https://qualitycat.pl" target="_blank" rel="noopener">qualitycat.pl ↗</a></li>
        <li><a href={locale === 'pl' ? '/en/' : '/pl/'}>{locale === 'pl' ? 'English version' : 'Wersja polska'}</a></li>
      </ul>
    </div>
  </div>

  <div class="footer-bottom container">
    <span class="made-by">
      <strong>quality blog</strong> · {strings.footer.madeBy} <a href="https://qualitycat.pl" target="_blank" rel="noopener">Quality Cat</a>
    </span>
    <span class="fonts">Geist · Lora · JetBrains Mono</span>
    <span class="copy">&copy; {new Date().getFullYear()} · quality-blog.eu</span>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 96px;
    padding-block: 56px 36px;
    border-top: 1px solid var(--border);
    background: var(--bg);
  }

  .footer-top {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: 48px;
    padding-bottom: 36px;
    border-bottom: 1px solid var(--border-soft);
  }

  .brand .logo-row {
    display: flex;
    align-items: center;
    gap: 9px;
  }
  .mark {
    width: 22px;
    height: 22px;
    border-radius: 5px;
    background: var(--fg);
    color: var(--bg);
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 14px;
    font-weight: 500;
    line-height: 1;
    flex-shrink: 0;
  }
  .brand-name {
    font-family: var(--font-body);
    font-size: 15.5px;
    font-weight: 600;
    letter-spacing: -0.015em;
    color: var(--fg);
    line-height: 1;
  }
  .brand-name em {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    color: var(--fg-muted);
    margin-left: 1px;
  }
  .tagline {
    margin-top: 14px;
    color: var(--fg-muted);
    font-size: 14px;
    max-width: 42ch;
    line-height: 1.55;
  }

  .col-title {
    margin-bottom: 12px;
    color: var(--fg-subtle);
  }
  .col ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .col a {
    color: var(--fg-muted);
    font-size: 14px;
    transition: color 180ms;
  }
  .col a:hover { color: var(--fg); }

  .footer-bottom {
    margin-top: 24px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--fg-subtle);
    letter-spacing: 0.02em;
  }
  .footer-bottom strong { color: var(--fg-muted); font-weight: 500; }
  .footer-bottom a { color: var(--fg-muted); }
  .footer-bottom a:hover { color: var(--fg); }

  @media (max-width: 720px) {
    .footer-top { grid-template-columns: 1fr; gap: 28px; }
    .footer-bottom { flex-direction: column; gap: 8px; align-items: flex-start; }
  }
</style>
