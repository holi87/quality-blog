---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import type { Locale } from '../i18n/translations';
import {
  DEFAULT_OG_IMAGE,
  SITE_URL,
  absoluteUrl,
  localizedAlternates,
  normalizePath,
  type AlternatePaths,
  type JsonLdNode,
} from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  locale?: Locale;
  currentPath?: string;
  canonicalPath?: string;
  alternatePaths?: AlternatePaths;
  ogImage?: string;
  ogType?: 'website' | 'article';
  publishedTime?: Date;
  tags?: string[];
  robots?: string;
  jsonLd?: JsonLdNode | JsonLdNode[];
}

const {
  title,
  description = 'quality blog - praktyczna wiedza o smart home, AI, lokalnych LLM i automatyzacji bez marketingowego szumu.',
  locale = 'pl',
  currentPath = '',
  canonicalPath,
  alternatePaths,
  ogImage = DEFAULT_OG_IMAGE,
  ogType = 'website',
  publishedTime,
  tags = [],
  robots = 'index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1',
  jsonLd,
} = Astro.props;

const siteName = 'quality blog';
const defaultAlternatePath = currentPath || '/';
const defaultAlternates = localizedAlternates(
  `/pl${defaultAlternatePath === '/' ? '/' : normalizePath(defaultAlternatePath)}`,
  `/en${defaultAlternatePath === '/' ? '/' : normalizePath(defaultAlternatePath)}`,
);
const resolvedAlternates = alternatePaths ?? defaultAlternates;
const canonicalURL = absoluteUrl(canonicalPath ?? Astro.url.pathname);
const ogImageURL = /^https?:\/\//i.test(ogImage) ? ogImage : new URL(ogImage, SITE_URL).toString();
const jsonLdItems = !jsonLd ? [] : Array.isArray(jsonLd) ? jsonLd : [jsonLd];
const otherLocale = locale === 'pl' ? 'en' : 'pl';
const ogLocale = locale === 'pl' ? 'pl_PL' : 'en_US';
const ogLocaleAlternate = otherLocale === 'pl' ? 'pl_PL' : 'en_US';

function stringifyJsonLd(item: JsonLdNode): string {
  return JSON.stringify({
    '@context': 'https://schema.org',
    ...item,
  }).replace(/</g, '\\u003c');
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title} · {siteName}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonicalURL} />

    {/* Favicons */}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate icon" href="/favicon.ico" />
    <link rel="mask-icon" href="/favicon.svg" color="#2f3437" />
    <meta name="theme-color" content="#1f1f1d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f7f6f3" media="(prefers-color-scheme: light)" />

    {/* OpenGraph */}
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:locale" content={ogLocale} />
    {resolvedAlternates[otherLocale] && <meta property="og:locale:alternate" content={ogLocaleAlternate} />}
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}

    {/* Twitter */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    {/* RSS */}
    <link rel="alternate" type="application/rss+xml" title={`${siteName} — PL`} href="/pl/rss.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} — EN`} href="/en/rss.xml" />

    {/* Language alternates */}
    {resolvedAlternates.pl && <link rel="alternate" hreflang="pl" href={absoluteUrl(resolvedAlternates.pl)} />}
    {resolvedAlternates.en && <link rel="alternate" hreflang="en" href={absoluteUrl(resolvedAlternates.en)} />}
    {resolvedAlternates['x-default'] && <link rel="alternate" hreflang="x-default" href={absoluteUrl(resolvedAlternates['x-default'])} />}

    {jsonLdItems.map((item) => <script type="application/ld+json" set:html={stringifyJsonLd(item)} />)}

    {/* No-flash theme init — runs before first paint */}
    <script is:inline>
      (function () {
        try {
          const stored = localStorage.getItem('theme');
          const prefers = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
          const theme = stored || prefers;
          document.documentElement.setAttribute('data-theme', theme);
        } catch (_) {
          document.documentElement.setAttribute('data-theme', 'dark');
        }
      })();
    </script>

    <ClientRouter />
  </head>
  <body>
    <div class="reading-progress" id="reading-progress"></div>
    <Nav locale={locale} currentPath={currentPath} alternatePaths={resolvedAlternates} />
    <main id="main">
      <slot />
    </main>
    <Footer locale={locale} />

    <script>
      // Reading progress + theme toggle support — re-runs on View Transitions
      function setupProgress() {
        const bar = document.getElementById('reading-progress');
        if (!bar) return;
        const update = () => {
          const h = document.documentElement;
          const max = h.scrollHeight - h.clientHeight;
          const pct = max > 0 ? (h.scrollTop / max) * 100 : 0;
          bar.style.width = pct + '%';
        };
        update();
        window.addEventListener('scroll', update, { passive: true });
        window.addEventListener('resize', update);
      }
      function setupTheme() {
        const btn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
        if (!btn) return;
        btn.addEventListener('click', () => {
          const current = document.documentElement.getAttribute('data-theme') || 'dark';
          const next = current === 'dark' ? 'light' : 'dark';
          document.documentElement.setAttribute('data-theme', next);
          try { localStorage.setItem('theme', next); } catch (_) {}
        });
      }
      setupProgress();
      setupTheme();
      document.addEventListener('astro:page-load', () => {
        setupProgress();
        setupTheme();
      });
    </script>
  </body>
</html>
