---
/*
  Root `/` — serves the PL homepage directly (no visible redirect).
  The same content is also reachable at /pl/ for canonical i18n consistency.
*/
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import Tag from '../components/Tag.astro';
import { t } from '../i18n/translations';
import { blogJsonLd, localizedAlternates, organizationJsonLd, websiteJsonLd } from '../lib/seo';

const locale = 'pl' as const;
const strings = t(locale);

const now = new Date();
const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((post) => post.data.lang === locale && post.data.date <= now)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 6);

function getSlug(postId: string): string {
  return postId.replace(/^[a-z]{2}\//, '');
}

const topics = ['Home Assistant', 'Claude/ChatGPT', 'Automatyzacja', 'IoT', 'Prompt Engineering'];
const totalPosts = allPosts.filter((p) => p.data.lang === locale && p.data.date <= now).length;
const lastUpdate = posts[0]?.data.date;
const alternatePaths = localizedAlternates('/pl/', '/en/');
const seoDescription = 'Praktyczny blog o AI, smart home i QA — Claude Code, MCP, lokalne LLM, prompt engineering, Home Assistant, automatyzacja testów.';
---

<BaseLayout
  title="AI, smart home, QA i automatyzacja"
  description={seoDescription}
  locale={locale}
  currentPath="/"
  canonicalPath="/pl/"
  alternatePaths={alternatePaths}
  jsonLd={[organizationJsonLd(), websiteJsonLd(locale), blogJsonLd(locale, posts)]}
>
  <section class="hero">
    <div class="hero-inner container">
      <div class="hero-meta eyebrow rise">
        <span class="dot" aria-hidden="true"></span>
        <span>quality blog</span>
        <span class="sep">/</span>
        <span>edycja {new Date().getFullYear()}</span>
      </div>

      <h1 class="hero-title rise" style="animation-delay: 80ms;">
        {strings.hero.title}{' '}
        <em>{strings.hero.highlight1}</em>,{' '}
        <em>{strings.hero.highlight2}</em>{' '}
        <span class="amp">{strings.hero.and}</span>{' '}
        <em>{strings.hero.highlight3}</em>.
      </h1>

      <p class="hero-lede rise" style="animation-delay: 160ms;">
        {strings.hero.description}
      </p>

      <div class="hero-topics rise" style="animation-delay: 240ms;">
        {topics.map((tag) => <Tag label={tag} variant="ghost" />)}
      </div>

      <dl class="hero-stats rise" style="animation-delay: 320ms;">
        <div>
          <dt>Artykułów</dt>
          <dd><span class="num">{String(totalPosts).padStart(2, '0')}</span></dd>
        </div>
        <div>
          <dt>Języki</dt>
          <dd><span class="num">PL · EN</span></dd>
        </div>
        <div>
          <dt>Ostatni wpis</dt>
          <dd><span class="num">{lastUpdate ? lastUpdate.toLocaleDateString('pl-PL', { day: '2-digit', month: 'short' }) : '—'}</span></dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="posts container">
    <header class="posts-header">
      <p class="eyebrow">{strings.posts.latest}</p>
      <a class="see-all" href="/pl/blog/">{strings.posts.allPosts} →</a>
    </header>
    <div class="posts-grid">
      {posts.map((post, i) => (
        <PostCard
          index={i + 1}
          title={post.data.title}
          description={post.data.description}
          date={post.data.date}
          author={post.data.author}
          readingTime={post.data.readingTime}
          tags={post.data.tags}
          slug={getSlug(post.id)}
          locale={locale}
        />
      ))}
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding-block: clamp(56px, 8vw, 112px) clamp(40px, 5vw, 72px);
  }
  .hero-inner { position: relative; max-width: 960px; }
  .hero-meta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 11px;
    background: var(--bg-elev);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--fg-muted);
    margin-bottom: 28px;
  }
  .hero-meta .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--p-green-fg);
  }
  .hero-meta .sep { color: var(--fg-subtle); opacity: 0.5; }

  .hero-title {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--step-6);
    color: var(--fg);
    max-width: 18ch;
    line-height: 1.05;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }
  .hero-title em {
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 500;
    color: var(--fg);
    letter-spacing: -0.015em;
  }
  .hero-title .amp {
    font-family: var(--font-display);
    font-style: italic;
    color: var(--fg-muted);
    font-weight: 400;
  }
  .hero-lede {
    margin-top: 28px;
    max-width: 56ch;
    font-size: var(--step-1);
    color: var(--fg-muted);
    line-height: 1.55;
  }
  .hero-lede em { font-family: var(--font-display); font-style: italic; color: var(--fg); }
  .hero-topics {
    margin-top: 28px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .hero-stats {
    margin-top: 52px;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 220px));
    padding-top: 24px;
    border-top: 1px solid var(--border);
    max-width: 700px;
  }
  .hero-stats > div { padding-right: 24px; border-right: 1px solid var(--border); }
  .hero-stats > div:last-child { border-right: 0; padding-left: 24px; padding-right: 0; }
  .hero-stats > div:nth-child(2) { padding-left: 24px; }
  .hero-stats dt {
    font-family: var(--font-mono);
    font-size: 10.5px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--fg-subtle);
    margin-bottom: 6px;
  }
  .hero-stats dd .num {
    font-family: var(--font-body);
    font-size: 22px;
    font-weight: 600;
    color: var(--fg);
    letter-spacing: -0.015em;
  }
  .posts { padding-block: clamp(40px, 6vw, 80px); }
  .posts-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 28px;
    padding-bottom: 14px;
    border-bottom: 1px solid var(--border);
  }
  .see-all {
    font-family: var(--font-mono);
    font-size: 11.5px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fg-muted);
    transition: color 180ms;
  }
  .see-all:hover { color: var(--fg); }
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  @media (max-width: 900px) { .posts-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) {
    .posts-grid { grid-template-columns: 1fr; }
    .hero-stats { grid-template-columns: 1fr; max-width: none; }
    .hero-stats > div,
    .hero-stats > div:last-child,
    .hero-stats > div:nth-child(2) {
      border-right: 0;
      padding: 0 0 16px;
      border-bottom: 1px solid var(--border);
    }
    .hero-stats > div:last-child { border-bottom: 0; padding-bottom: 0; }
  }
</style>
