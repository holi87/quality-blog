---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { aboutPageJsonLd, localizedAlternates, organizationJsonLd, websiteJsonLd } from '../../lib/seo';

const alternatePaths = localizedAlternates('/pl/o-projekcie/', '/en/about/');
const seoDescription = 'About quality blog and Quality Cat: Grzegorz Holak, Julia Sielska, Konrad "Gumiś" Gomulski and Filip Barszcz, with professional context connected with Sii Polska, Santander Corporate & Investment Banking and ABB Polska.';
---

<BaseLayout
  title="About Quality Blog"
  description={seoDescription}
  locale="en"
  currentPath="/about"
  canonicalPath="/en/about/"
  alternatePaths={alternatePaths}
  jsonLd={[organizationJsonLd(), websiteJsonLd('en'), aboutPageJsonLd('en', '/en/about/')]}
>
  <section class="about">
    <div class="about-hero">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="container about-inner">
        <p class="eyebrow">/ about</p>
        <h1 class="display">About <em>Quality Blog</em>.</h1>
        <p class="lede">
          <strong>quality blog</strong> is a place where we share practical knowledge
          about smart home and artificial intelligence. No marketing fluff, no paywalls -
          just useful content.
        </p>
      </div>
    </div>

    <div class="container about-body">
      <div class="col">
        <p class="eyebrow">Topics</p>
        <ul class="topic-list">
          <li>
            <span class="dot" style="--c: var(--accent-2)"></span>
            <div>
              <strong>Smart Home</strong>
              <p>Home Assistant, Zigbee, automations, IoT</p>
            </div>
          </li>
          <li>
            <span class="dot" style="--c: var(--accent)"></span>
            <div>
              <strong>AI</strong>
              <p>prompt engineering, AI tools, practical applications</p>
            </div>
          </li>
          <li>
            <span class="dot" style="--c: var(--accent-3)"></span>
            <div>
              <strong>Automation</strong>
              <p>from home to business processes</p>
            </div>
          </li>
        </ul>
      </div>

      <div class="col">
        <p class="eyebrow">Who's behind this</p>
        <p class="who">
          The blog is run by
          <a href="https://qualitycat.com.pl" target="_blank" rel="noopener">Quality Cat</a>
          - a company co-founded by <strong>Julia Sielska</strong> and <strong>Grzegorz Holak</strong> on the belief that
          good knowledge should be accessible to everyone.
        </p>
        <p class="eyebrow manifest-label">Manifesto</p>
        <blockquote>
          <p>No paywalls. No clickbait. No "10 reasons why…". Just solid knowledge, written like a human.</p>
        </blockquote>
      </div>
    </div>

    <div class="container authors-wrap">
      <p class="eyebrow">Authors</p>
      <div class="authors">
        <article class="author-card">
          <h3 class="author-name">Julia Sielska</h3>
          <p class="author-role">Quality Cat co-founder · ABB Polska</p>
          <p class="author-bio">
            Co-founder of <a href="https://qualitycat.com.pl" target="_blank" rel="noopener"><strong>Quality Cat</strong></a>.
            Works day-to-day with ERP systems at <strong>ABB Polska</strong> and tests Grzegorz's wildest ideas at home.
          </p>
        </article>
        <article class="author-card">
          <h3 class="author-name">Grzegorz Holak</h3>
          <p class="author-role">QA Architect @ SCIB · Senior TDE @ Sii Polska</p>
          <p class="author-bio">
            <strong>QA Architect</strong> at Santander Corporate &amp; Investment Banking and
            <strong>Senior TDE</strong> at Sii Polska. Co-founder of
            <a href="https://qualitycat.com.pl" target="_blank" rel="noopener"><strong>Quality Cat</strong></a>
            - and the person behind the idea of sharing what we've picked up along the way.
            More at <a href="https://holak.net.pl" target="_blank" rel="noopener">holak.net.pl</a>.
          </p>
        </article>
        <article class="author-card">
          <h3 class="author-name">Konrad "Gumiś" Gomulski</h3>
          <p class="author-role">Senior TDE @ Sii Polska</p>
          <p class="author-bio">
            <strong>Senior TDE</strong> at Sii Polska. Has been backing the blog from day one -
            even if his own posts are few, he reads and reviews everyone else's.
          </p>
        </article>
        <article class="author-card">
          <h3 class="author-name">Filip Barszcz</h3>
          <p class="author-role">QA Chapter Lead @ SCIB</p>
          <p class="author-bio">
            <strong>QA Chapter Lead</strong> at Santander Corporate &amp; Investment Banking.
            Fights alongside Grzegorz for better quality every day.
          </p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about-hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(48px, 7vw, 96px) clamp(32px, 4vw, 48px);
    border-bottom: 1px solid var(--border-soft);
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(to right, var(--grid-line) 1px, transparent 1px),
      linear-gradient(to bottom, var(--grid-line) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 70% 50% at 30% 40%, black 50%, transparent 100%);
    -webkit-mask-image: radial-gradient(ellipse 70% 50% at 30% 40%, black 50%, transparent 100%);
  }
  .about-inner { position: relative; max-width: 860px; }
  .about-inner h1 {
    font-size: var(--step-5);
    color: var(--fg);
    margin-top: 8px;
    max-width: 16ch;
  }
  .about-inner h1 em {
    font-style: italic;
    color: var(--accent);
    font-variation-settings: 'SOFT' 100, 'opsz' 144;
  }
  .lede {
    margin-top: 24px;
    font-size: var(--step-1);
    color: var(--fg-muted);
    line-height: 1.55;
    max-width: 60ch;
  }
  .lede strong { color: var(--fg); }

  .about-body {
    padding-block: clamp(40px, 6vw, 72px);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(32px, 5vw, 72px);
    max-width: 1040px;
  }
  .col .eyebrow { color: var(--fg-subtle); margin-bottom: 18px; }
  .manifest-label { margin-top: 36px; }

  .topic-list { list-style: none; display: flex; flex-direction: column; gap: 20px; }
  .topic-list li { display: flex; gap: 14px; align-items: flex-start; }
  .topic-list .dot {
    width: 8px;
    height: 8px;
    margin-top: 9px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 3px color-mix(in oklab, var(--c) 22%, transparent);
    flex-shrink: 0;
  }
  .topic-list strong {
    font-family: var(--font-display);
    font-size: 20px;
    color: var(--fg);
    font-weight: 500;
  }
  .topic-list p {
    color: var(--fg-muted);
    font-size: 14px;
    margin-top: 2px;
  }

  .who {
    color: var(--fg);
    font-size: 16px;
    line-height: 1.7;
  }
  .who a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: color-mix(in oklab, var(--accent) 35%, transparent);
  }
  .who a:hover { text-decoration-color: var(--accent); }

  blockquote {
    margin-top: 12px;
    padding: 18px 20px;
    border-left: 3px solid var(--accent);
    background: color-mix(in oklab, var(--accent) 6%, var(--bg-elev));
    border-radius: 0 10px 10px 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: 18px;
    color: var(--fg);
    line-height: 1.55;
  }

  @media (max-width: 720px) {
    .about-body { grid-template-columns: 1fr; }
  }

  .authors-wrap {
    padding-block: clamp(24px, 4vw, 56px) clamp(48px, 7vw, 96px);
    border-top: 1px solid var(--border-soft);
    max-width: 1040px;
  }
  .authors-wrap .eyebrow {
    color: var(--fg-subtle);
    margin-bottom: 24px;
  }
  .authors {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 20px;
  }
  .author-card {
    background: var(--bg-elev);
    border: 1px solid var(--border-soft);
    border-radius: 14px;
    padding: 22px;
    transition: border-color 0.2s, transform 0.2s;
  }
  .author-card:hover {
    border-color: color-mix(in oklab, var(--accent) 35%, var(--border-soft));
    transform: translateY(-2px);
  }
  .author-name {
    font-family: var(--font-display);
    font-size: 20px;
    font-weight: 500;
    color: var(--fg);
    margin: 0 0 4px;
  }
  .author-role {
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--accent);
    margin: 0 0 12px;
  }
  .author-bio {
    color: var(--fg-muted);
    font-size: 14px;
    line-height: 1.65;
    margin: 0;
  }
  .author-bio strong { color: var(--fg); font-weight: 600; }
</style>
