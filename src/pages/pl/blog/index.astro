---
import { getCollection } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PostCard from '../../../components/PostCard.astro';
import Tag from '../../../components/Tag.astro';
import { t } from '../../../i18n/translations';
import { blogJsonLd, localizedAlternates, organizationJsonLd, websiteJsonLd } from '../../../lib/seo';

const locale = 'pl';
const strings = t(locale);

const now = new Date();
const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((post) => post.data.lang === locale && post.data.date <= now)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

function getSlug(postId: string): string {
  return postId.replace(/^[a-z]{2}\//, '');
}

const allTags = [...new Set(posts.flatMap((post) => post.data.tags))].sort();
const alternatePaths = localizedAlternates('/pl/blog/', '/en/blog/');
const seoDescription = 'Wszystkie wpisy quality blog o AI, lokalnych LLM, Claude Code, MCP, QA automation, Home Assistant, IoT i smart home.';
---

<BaseLayout
  title="Blog o AI, smart home i QA"
  description={seoDescription}
  locale={locale}
  currentPath="/blog"
  canonicalPath="/pl/blog/"
  alternatePaths={alternatePaths}
  jsonLd={[organizationJsonLd(), websiteJsonLd(locale), blogJsonLd(locale, posts)]}
>
  <section class="blog-hero">
    <div class="hero-grid" aria-hidden="true"></div>
    <div class="container blog-hero__inner">
      <p class="eyebrow">/ blog</p>
      <h1 class="display">{strings.posts.allPosts}</h1>
      <p class="lede">Dzielimy się wiedzą o AI, smart home i QA. Claude Code, MCP, lokalne LLM, Home Assistant, prompt engineering i automatyzacja testów - bez paywalli i marketingowego szumu.</p>

      <div class="tag-bar" role="tablist" aria-label="Filtruj po tagach">
        <button class="tag-chip is-active" data-tag="all" role="tab" aria-selected="true">
          <span class="dot" data-cat="default" aria-hidden="true"></span>
          <span>wszystkie</span>
          <span class="count">{posts.length}</span>
        </button>
        {allTags.map((tag) => {
          const count = posts.filter((p) => p.data.tags.includes(tag)).length;
          return (
            <button class="tag-chip" data-tag={tag} role="tab" aria-selected="false">
              <span class="dot" data-cat={tag.toLowerCase().replace(/\//g, '-').replace(/[^a-z0-9-]+/g, '-')} aria-hidden="true"></span>
              <span>{tag}</span>
              <span class="count">{count}</span>
            </button>
          );
        })}
      </div>
    </div>
  </section>

  <section class="blog-list container">
    <div class="posts-grid" id="posts-grid">
      {posts.map((post, i) => (
        <div class="post-wrap" data-tags={post.data.tags.join('|')}>
          <PostCard
            index={i + 1}
            title={post.data.title}
            description={post.data.description}
            date={post.data.date}
            author={post.data.author}
            readingTime={post.data.readingTime}
            tags={post.data.tags}
            slug={getSlug(post.id)}
            locale={locale}
          />
        </div>
      ))}
    </div>
    <p class="empty" id="empty-state" hidden>Brak wpisów dla wybranego tagu.</p>
  </section>
</BaseLayout>

<script>
  function setupBlogFilter() {
    const grid = document.getElementById('posts-grid');
    const empty = document.getElementById('empty-state');
    if (!grid) return;

    const chips = document.querySelectorAll<HTMLButtonElement>('.tag-chip');
    const params = new URLSearchParams(window.location.search);
    const initial = params.get('tag') ?? 'all';

    const apply = (tag: string) => {
      const items = grid.querySelectorAll<HTMLElement>('.post-wrap');
      let visible = 0;
      items.forEach((item) => {
        const tags = (item.dataset.tags ?? '').split('|');
        const match = tag === 'all' || tags.includes(tag);
        item.style.display = match ? '' : 'none';
        if (match) visible++;
      });
      if (empty) empty.hidden = visible > 0;

      chips.forEach((chip) => {
        const isActive = chip.dataset.tag === tag;
        chip.classList.toggle('is-active', isActive);
        chip.setAttribute('aria-selected', isActive ? 'true' : 'false');
      });

      const url = new URL(window.location.href);
      if (tag === 'all') url.searchParams.delete('tag');
      else url.searchParams.set('tag', tag);
      history.replaceState(null, '', url.toString());
    };

    chips.forEach((chip) => {
      chip.addEventListener('click', () => apply(chip.dataset.tag ?? 'all'));
    });

    apply(initial);
  }
  setupBlogFilter();
  document.addEventListener('astro:page-load', setupBlogFilter);
</script>

<style>
  .blog-hero {
    position: relative;
    padding-block: clamp(48px, 6vw, 80px) clamp(28px, 3vw, 40px);
    border-bottom: 1px solid var(--border);
  }
  .hero-grid { display: none; }
  .blog-hero__inner { position: relative; max-width: 920px; }
  .blog-hero h1 {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--step-5);
    color: var(--fg);
    margin-top: 8px;
    letter-spacing: -0.03em;
    line-height: 1.05;
    text-wrap: balance;
  }
  .blog-hero .lede {
    margin-top: 18px;
    color: var(--fg-muted);
    font-size: var(--step-1);
    max-width: 60ch;
    line-height: 1.55;
  }

  .tag-bar {
    margin-top: 32px;
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .tag-chip {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-mono);
    font-size: 11px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--fg-muted);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 999px;
    padding: 5px 10px;
    transition: color 180ms, border-color 180ms, background 180ms;
  }
  .tag-chip .dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--cat, var(--fg-muted));
  }
  .tag-chip .count {
    font-size: 10px;
    color: var(--fg-subtle);
    margin-left: 1px;
  }
  .tag-chip:hover {
    color: var(--fg);
    border-color: var(--fg-subtle);
  }
  .tag-chip.is-active {
    color: var(--fg);
    background: var(--cat-bg, var(--bg-elev));
    border-color: transparent;
  }
  .tag-chip.is-active .count { color: var(--cat-fg, var(--fg)); opacity: 0.7; }

  .blog-list { padding-block: clamp(32px, 5vw, 56px); }
  .posts-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 14px;
  }
  .post-wrap { display: flex; }
  .post-wrap > * { flex: 1; }
  .empty {
    text-align: center;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    font-size: 13px;
    padding: 60px 20px;
  }
  @media (max-width: 900px) { .posts-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 600px) { .posts-grid { grid-template-columns: 1fr; } }
</style>
