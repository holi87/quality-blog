---
import { getCollection, render } from 'astro:content';
import BlogPost from '../../../layouts/BlogPost.astro';
import {
  blogPostingJsonLd,
  breadcrumbJsonLd,
  isPublished,
  organizationJsonLd,
  postAlternatePaths,
  postPath,
  postSlug,
  websiteJsonLd,
} from '../../../lib/seo';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog');
  const now = new Date();
  const publishedPosts = allPosts.filter((post) => isPublished(post, now));
  const plPosts = publishedPosts.filter((post) => post.data.lang === 'pl');

  return plPosts.map((post) => {
    const slug = postSlug(post.id);
    const alternatePaths = postAlternatePaths(publishedPosts, post);
    const canonicalPath = alternatePaths.pl ?? postPath('pl', slug);
    return {
      params: { slug },
      props: {
        post,
        slug,
        canonicalPath,
        alternatePaths,
        jsonLd: [
          organizationJsonLd(),
          websiteJsonLd('pl'),
          blogPostingJsonLd(post, alternatePaths),
          breadcrumbJsonLd([
            { name: 'Strona glowna', path: '/pl/' },
            { name: 'Blog', path: '/pl/blog/' },
            { name: post.data.title, path: canonicalPath },
          ]),
        ],
      },
    };
  });
}

const { post, slug, canonicalPath, alternatePaths, jsonLd } = Astro.props;
const { Content } = await render(post);
---

<BlogPost
  title={post.data.title}
  description={post.data.description}
  date={post.data.date}
  readingTime={post.data.readingTime}
  tags={post.data.tags}
  locale="pl"
  slug={slug}
  canonicalPath={canonicalPath}
  alternatePaths={alternatePaths}
  jsonLd={jsonLd}
>
  <Content />
</BlogPost>
